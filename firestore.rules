rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Administrators may inspect application collections, including nested room data.
    // Legacy password hashes remain server-only.
    match /{rootCollection}/{document=**} {
      allow read: if isAdmin() && rootCollection != 'credentials';
    }

    match /official_prompts/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_metadata/{document} {
      allow read, write: if isAdmin();
    }

    match /custom_decks/{deckId} {
      allow read: if isAdmin() || resource.data.visibility in ['public', 'unlisted']
                  || (request.auth != null && resource.data.creatorUid == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null && request.resource.data.creatorUid == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && resource.data.creatorUid == request.auth.uid
                    && request.resource.data.creatorUid == resource.data.creatorUid);
      allow delete: if isAdmin() || (request.auth != null && resource.data.creatorUid == request.auth.uid);
    }

    match /community_submissions/{submissionId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.submitterUid == request.auth.uid);
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /card_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // === JINX KISS SOCIAL PARTY GAME RULES ===

    // Users and Profiles
    match /users/{uid} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == uid && request.resource.data.role == 'user');
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && resource.data.role != 'admin');
    }

    match /usernames/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /credentials/{uid} {
      allow read, write: if false; // Server-only via Firebase Admin SDK
    }

    // Custom Decks
    match /decks/{deckId} {
      allow read: if resource.data.visibility == 'public'
                  || resource.data.visibility == 'unlisted'
                  || (request.auth != null && resource.data.creatorId == request.auth.uid)
                  || (request.auth != null && request.auth.token.role == 'admin');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || request.auth.token.role == 'admin');
    }

    // Prompt Submissions
    match /submissions/{subId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Prompt Votes (Would You Rather & Community stats)
    match /votes/{promptId} {
      allow read, write: if true;
    }
    match /game_votes/{promptId} {
      allow read, write: if true;
    }

    // Card Ratings & Likes
    match /card_ratings/{cardId} {
      allow read, write: if true;
    }

    // Reports Moderation Queue
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Realtime Multiplayer Party Rooms
    match /rooms/{roomCode} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }
  }
}
