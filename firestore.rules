rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === JINX KISS SOCIAL PARTY GAME RULES ===

    // Users and Profiles
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
    }

    match /usernames/{name} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /credentials/{uid} {
      allow read, write: if false; // Server-only via Firebase Admin SDK
    }

    // Custom Decks
    match /decks/{deckId} {
      allow read: if resource.data.visibility == 'public'
                  || resource.data.visibility == 'unlisted'
                  || (request.auth != null && resource.data.creatorId == request.auth.uid)
                  || (request.auth != null && request.auth.token.role == 'admin');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || request.auth.token.role == 'admin');
    }

    // Prompt Submissions
    match /submissions/{subId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Prompt Votes (Would You Rather & Community stats)
    match /votes/{promptId} {
      allow read, write: if true;
    }

    // Card Ratings & Likes
    match /card_ratings/{cardId} {
      allow read, write: if true;
    }

    // Reports Moderation Queue
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Realtime Multiplayer Party Rooms
    match /rooms/{roomCode} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }
  }
}
